<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Точное планирование будильников (AlarmManager.setAlarmClock / setExactAndAllowWhileIdle) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 2. Удержание процессора и запуск Foreground-сервиса звонка и эскалации -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 3. Вывод полноэкранного экрана будильника поверх блокировки (без SYSTEM_ALERT_WINDOW) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 4. Вибрация и опциональный обход режима «Не беспокоить» (с явным согласием пользователя) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 5. Восстановление расписания будильников после перезагрузки устройства -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 6. Датчики для выполнения миссий: Камера (QR), NFC-метка, Шагомер, Микрофон (Голосовая фраза) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 7. Локальная сеть / Интернет исключительно для вызова пользовательского Webhook умного дома -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Аппаратные фичи помечены как необязательные (required="false"), чтобы приложение работало на любых устройствах -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Видимость системных сервисов распознавания речи и выбора мелодий для Android 11–16 (targetSdk 36) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.RINGTONE_PICKER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground-сервис удержания звонка, расчёта эскалации и контроля миссии -->
        <service
            android:name=".alarm.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Приёмник срабатывания будильника, предварительного рассвета (T-15), сторожевого перезапуска и проверки анти-возврата -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.action.TRIGGER_ALARM" />
                <action android:name="com.example.action.WATCHDOG_REVIVE" />
                <action android:name="com.example.action.RESTORE_ALARM_NOTIFICATION" />
                <action android:name="com.example.action.PRE_ALARM_SUNRISE" />
                <action android:name="com.example.action.ANTI_RETURN_CHECK" />
                <action android:name="com.example.action.DISMISS_ANTI_RETURN" />
            </intent-filter>
        </receiver>

        <!-- Перепланирование всех активных будильников после перезагрузки -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Перепланирование при смене системного времени или часового пояса -->
        <receiver
            android:name=".alarm.TimeChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
