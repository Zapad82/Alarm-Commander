<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Исключаем DataStore с URL-адресами Webhook, Bearer-токеном и телефоном резервного контакта из облачного бэкапа -->
        <exclude domain="file" path="datastore/alarm_commander_settings.preferences_pb" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/alarm_commander_settings.preferences_pb" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
